# Adapted from the upstream Stash override; see sources.json for provenance.
name: '📺 BiliBili: 🛡️ ADBlock'
desc: '哔哩哔哩：去广告

  自定义去除APP内界面元素

  本仓库可选覆写：需本机 CA；来源和调整见 README.md / sources.json。'
openUrl: http://boxjs.com/#/app/BiliBili.ADBlock
author: 'ClydeTime[https://github.com/ClydeTime]

  VirgilClyne[https://github.com/VirgilClyne]

  app2smile[https://github.com/app2smile]

  RuCu6[https://github.com/RuCu6]

  Maasea[https://github.com/Maasea]'
homepage: https://biliverse.github.io/guide/ad-block
icon: https://github.com/Biliverse/ADBlock/raw/main/src/assets/icon_rounded.png
category: 🪐 Biliverse
date: '2026-10-17 17:08:28'
version: 0.7.5
http:
  mitm:
  - biliverse.github.io
  - manga.bilibili.com
  - api.live.bilibili.com
  - api.vc.bilibili.com
  - app.bilibili.com
  - app.biliapi.net
  - app.biliapi.com
  - api.bilibili.com
  - api.biliapi.net
  - grpc.biliapi.net
  - cm.bilibili.com
  - adtrack.qianwen.com
  - tkio-redirect.solar-engine.com
  url-rewrite:
  - ^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words - reject-dict
  - ^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr - reject-dict
  - ^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist - reject-dict
  - ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash - reject-dict
  - ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash - reject-dict
  - ^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? - reject-dict
  mock:
  - match: ^https?:\/\/(grpc\.biliapi\.net|app\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$
    base64: AAAAAAA=
    status-code: 200
    headers:
      Content-Type: application/grpc
      grpc-status: '0'
  script:
  - match: ^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/ADBlock(?:\?.*)?$
    name: PreferencePanes.Config.ADBlock
    type: request
    require-body: false
  - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/feed\/index\?
    name: 📺 BiliBili.ADBlock.request.json
    type: request
    require-body: false
  - match: ^https?:\/\/(cm\.bilibili\.com\/cm\/api\/(conversion\/mobile\/v2|fees\/wise)|adtrack\.qianwen\.com\/v3\/ad\/(show\/)?bilibili|tkio-redirect\.solar-engine\.com\/receive\/turl\/)
    name: 📺 BiliBili.ADBlock.request.json
    type: request
    require-body: false
  - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/(splash\/(brand\/list|event\/list2|list|show)|feed\/index(\/(relate\/)?story)?|search\/square)
    name: 📺 BiliBili.ADBlock.response.json
    type: response
    require-body: true
  - match: ^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/(web-interface\/wbi\/index\/top\/feed\/rcmd|vip\/ads\/materials)\?
    name: 📺 BiliBili.ADBlock.response.json
    type: response
    require-body: true
  - match: ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/page\/(bangumi|cinema\/tab\?)
    name: 📺 BiliBili.ADBlock.response.json
    type: response
    require-body: true
  - match: ^https?:\/\/api\.live\.bilibili\.com\/xlive\/(app-room\/v1\/index\/getInfoByRoom|app-interface\/v2\/(index\/feed|room\/recList))
    name: 📺 BiliBili.ADBlock.response.json
    type: response
    require-body: true
  - match: ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.(view\.v1\.View\/(View|TFInfo|RelatesFeed|PlayerRelates|ViewProgress)|viewunite\.v1\.View\/(View|RelatesFeed|AIRelateAsync|ViewProgress|PlayPause|ViewEndPage)|playerunite\.v1\.Player\/PlayViewUnite)$
    name: 📺 BiliBili.ADBlock.response.grpc
    type: response
    require-body: true
    binary-mode: true
    max-size: 262144
  - match: ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(All|Video)(Personal)?$
    name: 📺 BiliBili.ADBlock.response.grpc
    type: response
    require-body: true
    binary-mode: true
  - match: ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.playurl\.v1\.PlayURL\/PlayView$
    name: 📺 BiliBili.ADBlock.response.grpc
    type: response
    require-body: true
    binary-mode: true
  - match: ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$
    name: 📺 BiliBili.ADBlock.response.grpc
    type: response
    require-body: true
    binary-mode: true
  - match: ^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.community\.service\.dm\.v1\.DM\/(DmView|DmSegMobile)
    name: 📺 BiliBili.ADBlock.response.grpc
    type: response
    require-body: true
    binary-mode: true
  - match: ^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.main\.community\.reply\.v1\.Reply\/(MainList|DetailList|ReplyInfo)$
    name: 📺 BiliBili.ADBlock.response.grpc
    type: response
    require-body: true
    binary-mode: true
  - match: ^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.main\.community\.reply\.v2\.Reply\/SubjectDescription$
    name: 📺 BiliBili.ADBlock.response.grpc
    type: response
    require-body: true
    binary-mode: true
  - match: ^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView$
    name: 📺 BiliBili.ADBlock.response.grpc
    type: response
    require-body: true
    binary-mode: true
script-providers:
  PreferencePanes.Config.ADBlock:
    url: https://github.com/Biliverse/ADBlock/releases/download/v0.7.5/config.bundle.js
    interval: 86400
  📺 BiliBili.ADBlock.request.json:
    url: https://github.com/Biliverse/ADBlock/releases/download/v0.7.5/request.bundle.js
    interval: 86400
  📺 BiliBili.ADBlock.response.json:
    url: https://github.com/Biliverse/ADBlock/releases/download/v0.7.5/response.bundle.js
    interval: 86400
  📺 BiliBili.ADBlock.response.grpc:
    url: https://github.com/Biliverse/ADBlock/releases/download/v0.7.5/response.bundle.js
    interval: 86400
